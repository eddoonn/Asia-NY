# Copy to .env and fill in
DISCORD_WEBHOOK=

BROKER=etoro

# --- eToro (api-portal.etoro.com, key from account settings, verified account) ---
ETORO_MODE=demo
ETORO_PUBLIC_KEY=
ETORO_USER_KEY=
ETORO_SYMBOL=GOLD.24-7

# --- IG (alternative broker) ---
IG_ACCOUNT_TYPE=demo
IG_API_KEY=
IG_USERNAME=
IG_PASSWORD=
IG_ACCOUNT_ID=
IG_EPIC=CS.D.USGLD.CFD.IP
IG_CURRENCY=GBP

ACCOUNT_SIZE=10000
RISK_PCT=1.0
